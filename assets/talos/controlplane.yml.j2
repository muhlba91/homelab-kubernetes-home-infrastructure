{{- if .gates.CoralTPU }}
---
apiVersion: v1alpha1
kind: PCIDriverRebindConfig
name: 0000:05:00.0
targetDriver: vfio-pci
{{- end }}
---
apiVersion: v1alpha1
kind: UnattendedInstallConfig
installer:
  # renovate: datasource=github-releases packageName=siderolabs/talos
  image: factory.talos.dev/metal-installer/{{ .talos.Cluster.InstallImageHash }}:v1.14.0
provisioning:
  diskSelector:
    match: disk.dev_path == "{{ .talos.Machine.Disk }}"
  wipe: true
---
apiVersion: v1alpha1
kind: HostnameConfig
hostname: {{ .talos.Machine.Hostname }}
---
apiVersion: v1alpha1
kind: KubeSpanConfig
enabled: false
---
apiVersion: v1alpha1
kind: EtcFileConfig
name: multipath.conf
mode: 0o644
contents: |
  defaults {
      user_friendly_names yes
      find_multipaths yes
      path_selector "round-robin 0"
  }
---
apiVersion: v1alpha1
kind: SysctlConfig
params:
  net.core.bpf_jit_harden: "1"
  vm.max_map_count: "131060"
  net.ipv6.conf.all.accept_ra: "2"
---
apiVersion: v1alpha1
kind: KubeProxyConfig
enabled: false
---
# KubeClusterConfig intentionally NOT applied yet — known upstream bug:
# https://github.com/siderolabs/talos/issues/14338
#
apiVersion: v1alpha1
kind: KubeClusterConfig
clusterName: {{ .clusterName }}-cluster
endpoint: https://{{ .talos.Machine.Network.IP.V4 }}:6443
---
apiVersion: v1alpha1
kind: KubeServiceAccountConfig
issuer:
  privateKey: |
{{ .secrets.Certs.K8sServiceAccount.Key }}
  issuerURL: https://{{ .talos.Machine.Network.IP.V4 }}:6443
---
apiVersion: v1alpha1
kind: KubeAPIServerConfig
# renovate: datasource=github-releases packageName=siderolabs/kubelet
image: registry.k8s.io/kube-apiserver:v1.37.0
certExtraSANs:
  - {{ .talos.Machine.Network.IP.V4 }}
  - {{ .talos.Machine.Network.IP.V6 }}
---
apiVersion: v1alpha1
kind: KubeAuthorizerConfig
name: node
type: Node
---
apiVersion: v1alpha1
kind: KubeAuthorizerConfig
name: rbac
type: RBAC
---
apiVersion: v1alpha1
kind: KubeAuthenticationConfig
configuration:
  anonymous:
    conditions:
      - path: /livez
      - path: /readyz
      - path: /healthz
    enabled: true
  jwt: []
---
apiVersion: v1alpha1
kind: KubeAuditPolicyConfig
configuration:
  apiVersion: audit.k8s.io/v1
  kind: Policy
  rules:
    - level: Metadata
---
apiVersion: v1alpha1
kind: KubeControllerManagerConfig
# renovate: datasource=github-releases packageName=siderolabs/kubelet
image: registry.k8s.io/kube-controller-manager:v1.37.0
extraArgs:
  bind-address: 0.0.0.0
---
apiVersion: v1alpha1
kind: KubeSchedulerConfig
# renovate: datasource=github-releases packageName=siderolabs/kubelet
image: registry.k8s.io/kube-scheduler:v1.37.0
extraArgs:
  bind-address: 0.0.0.0
---
apiVersion: v1alpha1
kind: KubePrismConfig
port: 7445
---
apiVersion: v1alpha1
kind: LinkAliasConfig
name: wan0
selector:
  match: mac(link.hardware_addr) == "{{ .talos.Machine.Network.MAC }}"
---
apiVersion: v1alpha1
kind: LinkConfig
name: wan0
mtu: 1500
addresses:
  - address: {{ .talos.Machine.Network.IP.V4 }}/{{ .network.IPv4.CIDRMask }}
    routePriority: 1024
  - address: {{ .talos.Machine.Network.IP.V6 }}/{{ .network.IPv6.CIDRMask }}
    routePriority: 1024
routes:
  - gateway: {{ .network.IPv4.Gateway }}
  # - gateway: {{ .network.IPv6.Gateway }}
---
apiVersion: v1alpha1
kind: ResolverConfig
nameservers:
{{- range .network.Nameservers }}
  - address: {{ . }}
{{- end }}
hostDNS:
  enabled: true
---
apiVersion: v1alpha1
kind: KubeTalosAPIAccessConfig
allowedRoles:
  - os:admin
allowedKubernetesNamespaces:
  - kube-system
  - talos-system
---
apiVersion: v1alpha1
kind: KubeNetworkConfig
dnsDomain: cluster.local
podSubnets:
  - {{ .talos.Cluster.Network.PodSubnets.V4 }}
  - {{ .talos.Cluster.Network.PodSubnets.V6 }}
serviceSubnets:
  - {{ .talos.Cluster.Network.ServiceSubnets.V4 }}
  - {{ .talos.Cluster.Network.ServiceSubnets.V6 }}
---
apiVersion: v1alpha1
kind: KubeletConfig
# renovate: datasource=github-releases packageName=siderolabs/kubelet
image: ghcr.io/siderolabs/kubelet:v1.37.0
defaultRuntimeSeccompProfileEnabled: true
extraArgs:
  rotate-server-certificates: "true"
---
apiVersion: v1alpha1
kind: KubeNodeConfig
labels:
  node-role.kubernetes.io/control-plane: ""
---
apiVersion: v1alpha1
kind: KubeAPIServerCAConfig
issuingCA:
  cert: |
{{ .secrets.Certs.K8s.Cert }}
  key: |
{{ .secrets.Certs.K8s.Key }}
---
apiVersion: v1alpha1
kind: KubeAggregatorCAConfig
issuingCA:
  cert: |
{{ .secrets.Certs.K8sAggregator.Cert }}
  key: |
{{ .secrets.Certs.K8sAggregator.Key }}
---
apiVersion: v1alpha1
kind: KubeEtcdEncryptionConfig
config:
  resources:
    - providers:
        - secretbox:
            keys:
              - name: key2
                secret: {{ .secrets.Secrets.SecretboxEncryptionSecret }}
      resources:
        - secrets
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: binfmt_misc
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: btrfs
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: thunderbolt
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: thunderbolt_net
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: usbserial
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: vfio_pci
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: vfio_iommu_type1
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: uio_pci_generic
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: dm_multipath
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: dm_round_robin
{{- if .gates.Nvidia }}
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: nvidia
parameters:
  - NVreg_OpenRmEnableUnsupportedGpus=1
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: nvidia_uvm
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: nvidia_drm
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: nvidia_modeset
parameters:
  - NVreg_OpenRmEnableUnsupportedGpus=1
{{- end }}
{{- if .gates.CoralTPU }}
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: gasket
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: apex
{{- end }}
---
version: v1alpha1
debug: false
persist: true
machine:
  type: controlplane
  token: {{ .secrets.Trustdinfo.Token }}
  ca:
    crt: {{ .secrets.Certs.Os.Cert }}
    key: {{ .secrets.Certs.Os.Key }}
  certSANs: []
  features:
    rbac: true
    apidCheckExtKeyUsage: true
    diskQuotaSupport: true
  # configuration for the installer and kernel/extensions:
  # - hardware type: bare metal
  # - machine architecture: amd64
  # - secure boot: off
  # - extensions:
  #    - binfmt-misc
  #    - btrfs
  #    - drbd
  #    - fuse3
  #    - gasket-driver # only for coral
  #    - i915
  #    - intel-ucode
  #    - iscsi-tools
  #    - multipath-tools
  #    - nvidia-container-toolkit-production # only for nvidia
  #    - nvidia-open-gpu-kernel-modules-production # only for nvidia
  #    - nvme-cli
  #    - qemu-guest-agent # only for qemu based clusters
  #    - thunderbolt
  #    - util-linux-tools
  # - extra kernel arguments: intel_iommu=on iommu=pt
cluster:
  id: {{ .secrets.Cluster.Id }}
  secret: {{ .secrets.Cluster.Secret }}
  token: {{ .secrets.Secrets.BootstrapToken }}
  discovery:
    enabled: true
    registries:
      kubernetes:
        disabled: false
      service:
        disabled: false
  etcd:
    ca:
      crt: {{ .secrets.Certs.Etcd.Cert }}
      key: {{ .secrets.Certs.Etcd.Key }}
    # advertisedSubnets:
    #   - {{ .talos.Machine.Network.IP.V4 }}/{{ .network.IPv4.CIDRMask }}
    #   - {{ .talos.Machine.Network.IP.V6 }}/{{ .network.IPv6.CIDRMask }}
